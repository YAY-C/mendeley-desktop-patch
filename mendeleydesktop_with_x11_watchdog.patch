+def x11_window_belongs_to_process(window_id, pid):
+    """Return whether an X11 window belongs to pid."""
+    try:
+        output = subprocess.check_output(
+            ["xprop", "-id", window_id, "_NET_WM_PID"],
+            stderr=subprocess.STDOUT,
+            universal_newlines=True)
+    except (OSError, subprocess.CalledProcessError):
+        return False
+
+    match = re.search(r"_NET_WM_PID\(CARDINAL\).*?(\d+)", output)
+    return match is not None and int(match.group(1)) == pid
+
+def x11_has_process_window(pid):
+    """Return True/False for an X11 window owned by pid, or None if unavailable."""
+    try:
+        output = subprocess.check_output(
+            ["xprop", "-root", "_NET_CLIENT_LIST"],
+            stderr=subprocess.STDOUT,
+            universal_newlines=True)
+    except (OSError, subprocess.CalledProcessError):
+        return None
+
+    window_ids = re.findall(r"0x[0-9a-fA-F]+", output)
+    return any(x11_window_belongs_to_process(window_id, pid)
+               for window_id in window_ids)
+
+def terminate_process_group(process):
+    """Terminate the native application and its children."""
+    if process.poll() is not None:
+        return
+
+    try:
+        os.killpg(process.pid, signal.SIGTERM)
+    except ProcessLookupError:
+        return
+
+    deadline = time.time() + 5
+    while process.poll() is None and time.time() < deadline:
+        time.sleep(0.1)
+
+    if process.poll() is None:
+        os.killpg(process.pid, signal.SIGKILL)
+
+def run_mendeley_with_x11_watchdog(args):
+    """Run Mendeley and stop it when its last X11 window disappears."""
+    process = subprocess.Popen(args, start_new_session=True)
+    window_seen = False
+    missing_since = None
+
+    try:
+        while process.poll() is None:
+            has_window = x11_has_process_window(process.pid)
+
+            if has_window is True:
+                window_seen = True
+                missing_since = None
+            elif has_window is False and window_seen:
+                if missing_since is None:
+                    missing_since = time.time()
+                elif time.time() - missing_since >= 2:
+                    terminate_process_group(process)
+                    break
+
+            time.sleep(0.5)
+    except KeyboardInterrupt:
+        terminate_process_group(process)
+
+    return process.wait()
